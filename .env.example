# Environment Variables Reference
# Copy this file to .env and fill in your values.
# .env is excluded from version control (.gitignore).

# ── Flask server ────────────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Logging ─────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
