# Environment Variables Reference
# Copy this file to .env and fill in your values.
# .env is excluded from version control (.gitignore).

# ── Flask server ────────────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Logging ─────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Prometheus AI Orchestrator ───────────────────────────────────────────
# Set one of these to enable live AI routing via /api/prometheus/execute.
# If neither is set, the endpoint uses the doctrine-based local router.
OPENAI_API_KEY=
GROK_API_KEY=

# ── XRPL NFT Minting (arcana_enterprise_nfts/mint.py) ───────────────────
# Required only when running the minting script. NEVER commit this value.
XRPL_WALLET_SEED=
